    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>MC_MODE_DISPLAY</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Mode constant: display (read-only)</DESCRIPT>
    </SEOCOMPOTX>
