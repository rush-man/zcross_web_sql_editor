    <SEOCOMPOTX>
     <CMPNAME>ON_PBO</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Dynpro 0100 PBO hook</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>ON_PAI</CMPNAME>
     <LANGU>E</LANGU>
